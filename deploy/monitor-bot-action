#!/usr/bin/python3 -I
"""Помощник для действий бота, которым нужен root.

Устанавливается как /usr/local/sbin/monitor-bot-action (root:root, 755).
Бот вызывает его через sudo; sudoers разрешает ТОЛЬКО этот файл:
    monitor ALL=(root) NOPASSWD: /usr/local/sbin/monitor-bot-action *
Все аргументы проверяются здесь, поэтому бот не может выполнить ничего другого.

Команды:
    restart-service NAME   — systemctl restart, только службы из /etc/monitor-bot/allowed-services
    kill PID               — SIGTERM обычному процессу (не ядру, не systemd, не sshd/dockerd/containerd)
    cleanup-estimate       — сколько места освободит cleanup
    cleanup                — docker image prune, builder prune, journalctl --vacuum-size, apt clean
    reboot                 — перезагрузка сервера
    backup-status          — свежие копии в папках из /etc/monitor-bot/backup-watch (JSON)
    backup-fetch N         — последнюю копию из N-й папки backup-watch положить боту для отправки в Telegram
    update SHA             — обновить бота до коммита SHA с GitHub (в отдельной службе systemd, с откатом)
    bak-list               — старые копии кода /opt/monitor_bot.bak-* и их размер (JSON)
    prune-bak KEEP         — удалить старые копии кода, оставить KEEP самых новых
    io-top                 — процессы с наибольшим чтением/записью на диск за 2 секунды (JSON)
    ban-ip IP              — запретить входящие с IP через ufw (не локальные адреса и не IP с открытой SSH-сессией)
    unban-ip IP            — снять запрет, поставленный ботом
    banned-list            — IP, запрещённые ботом (JSON)

Обновление ставит только код бота. Сам помощник, sudoers и файл службы не обновляются автоматически:
так код с GitHub не может расширить права бота. Если они изменились, бот об этом напишет.
"""
import filecmp
import grp
import ipaddress
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

ALLOWED_FILE = "/etc/monitor-bot/allowed-services"
PROTECTED = {"systemd", "init", "sshd", "sshd-session", "dockerd", "containerd", "systemd-journald",
             "systemd-logind", "systemd-networkd", "systemd-resolved", "dbus-daemon", "monitor-bot"}
NAME_RE = re.compile(r"^[A-Za-z0-9_.@-]{1,64}$")
JOURNAL_LIMIT = "200M"
WATCH_FILE = "/etc/monitor-bot/backup-watch"
OUTBOX = "/run/monitor-bot-outbox"
BOT_GROUP = "monitor"
MAX_SEND = 45 * 1024 * 1024  # Telegram принимает от бота файлы до 50 МБ
REPO_FILE = "/etc/monitor-bot/update-repo"
DEFAULT_REPO = "testbox017-lab/server-monitor-bot"
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]{1,64}/[A-Za-z0-9_.-]{1,100}$")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
APP_DIR = "/opt/monitor_bot"
VENV_PY = "/opt/monitor_bot/venv/bin/python"
SERVICE = "monitor-bot"
BAK_RE = re.compile(r"^monitor_bot\.bak-[A-Za-z0-9_.-]{1,64}$")
RESULT_FILE = "/run/monitor-bot-update.json"
LOCK_FILE = "/run/monitor-bot-update.lock"
CODE_DIRS = ("tests", "deploy")
CODE_FILES = ("requirements.txt", "README.md", "config.example.yaml")
NOT_AUTO = (("deploy/monitor-bot-action", "/usr/local/sbin/monitor-bot-action"),
            ("deploy/sudoers-monitor-bot", "/etc/sudoers.d/monitor-bot"),
            ("deploy/monitor-bot.service", "/etc/systemd/system/monitor-bot.service"))
SETTLE_SEC = 30
BAN_COMMENT = "monitor-bot"


def die(msg: str, code: int = 2) -> None:
    print(msg)
    sys.exit(code)


def run(cmd: list[str], timeout: int = 300) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def allowed_services() -> set[str]:
    try:
        with open(ALLOWED_FILE, encoding="utf-8") as f:
            return {ln.strip() for ln in f if ln.strip() and not ln.startswith("#")}
    except OSError:
        return set()


def restart_service(name: str) -> None:
    if not NAME_RE.match(name):
        die("bad service name")
    if name not in allowed_services():
        die(f"service {name} is not in {ALLOWED_FILE}")
    r = run(["systemctl", "restart", name], timeout=120)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "systemctl failed", 1)
    print(run(["systemctl", "is-active", name]).stdout.strip())


def proc_name(pid: int) -> str:
    try:
        with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        die("no such process")


def kill(pid_s: str) -> None:
    if not pid_s.isdigit():
        die("bad pid")
    pid = int(pid_s)
    if pid <= 2 or pid == os.getpid() or pid == os.getppid():
        die("refused: protected pid")
    name = proc_name(pid)
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if not f.read():
                die("refused: kernel thread")
    except OSError:
        die("no such process")
    if name in PROTECTED:
        die(f"refused: {name} is protected")
    os.kill(pid, signal.SIGTERM)
    print(f"SIGTERM sent to {pid} ({name})")


def du_bytes(path: str) -> int:
    r = run(["du", "-sb", path])
    try:
        return int(r.stdout.split()[0])
    except (IndexError, ValueError):
        return 0


def cleanup_estimate() -> None:
    lines = []
    r = run(["docker", "system", "df", "--format", "{{.Type}}\t{{.Reclaimable}}"])
    if r.returncode == 0:
        for ln in r.stdout.splitlines():
            t, _, rec = ln.partition("\t")
            if t in ("Images", "Build Cache"):
                lines.append(f"docker {t}: {rec}")
    r = run(["journalctl", "--disk-usage"])
    if r.returncode == 0:
        lines.append(f"journal: {r.stdout.strip()} (limit {JOURNAL_LIMIT})")
    apt = du_bytes("/var/cache/apt/archives")
    lines.append(f"apt cache: {apt / 1e6:.0f} MB")
    print("\n".join(lines))


def cleanup() -> None:
    out = []
    for cmd in (["docker", "image", "prune", "-f"], ["docker", "builder", "prune", "-f"],
                ["journalctl", f"--vacuum-size={JOURNAL_LIMIT}"], ["apt-get", "clean"]):
        r = run(cmd)
        tail = (r.stdout.strip().splitlines() or [""])[-1] or (r.stderr.strip().splitlines() or [""])[-1]
        out.append(f"{' '.join(cmd[:3])}: {'ok' if r.returncode == 0 else 'error'} {tail}".strip())
    print("\n".join(out))


# ---------- бэкапы ----------

def watch_dirs() -> list[tuple[str, float]]:
    """[(папка, максимальный возраст в часах)] из WATCH_FILE: «/var/backups/x 26»."""
    out = []
    try:
        with open(WATCH_FILE, encoding="utf-8") as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#"):
                    continue
                parts = ln.split()
                path = parts[0]
                hours = float(parts[1]) if len(parts) > 1 else 26.0
                if os.path.isabs(path):
                    out.append((os.path.normpath(path), hours))
    except (OSError, ValueError):
        pass
    return out


def backup_files(path: str) -> list[tuple[str, int, float]]:
    """[(имя, размер, mtime)] обычных файлов папки, новые первыми."""
    files = []
    try:
        with os.scandir(path) as it:
            for e in it:
                if e.is_file(follow_symlinks=False):
                    st = e.stat(follow_symlinks=False)
                    files.append((e.name, st.st_size, st.st_mtime))
    except OSError:
        return []
    files.sort(key=lambda x: x[2], reverse=True)
    return files


def backup_status() -> None:
    res = []
    for path, hours in watch_dirs():
        files = backup_files(path)
        dated = [f for f in files if not f[0].startswith("latest")]  # latest.* — копия последнего
        res.append({"path": path, "max_age_h": hours, "exists": os.path.isdir(path),
                    "count": len(dated), "total": sum(f[1] for f in files),
                    "newest": list(dated[0]) if dated else (list(files[0]) if files else None),
                    "previous": list(dated[1]) if len(dated) > 1 else None})
    print(json.dumps(res, ensure_ascii=False))


def gid() -> int:
    try:
        return grp.getgrnam(BOT_GROUP).gr_gid
    except KeyError:
        return 0


def backup_fetch(n_s: str) -> None:
    """Копия последнего бэкапа в OUTBOX (root:monitor), чтобы бот мог отправить её в Telegram."""
    dirs = watch_dirs()
    if not n_s.isdigit() or int(n_s) >= len(dirs):
        die("bad index")
    path = dirs[int(n_s)][0]
    files = [f for f in backup_files(path) if not f[0].startswith("latest")] or backup_files(path)
    if not files:
        die("no backups", 1)
    name, size, _ = files[0]
    if size > MAX_SEND:
        die(f"too big: {size}", 1)
    # OUTBOX в /run принадлежит root: пользователь бота не может подложить туда ссылку
    if os.path.lexists(OUTBOX) and (os.path.islink(OUTBOX) or not os.path.isdir(OUTBOX)):
        die("bad outbox", 1)
    os.makedirs(OUTBOX, exist_ok=True)
    os.chown(OUTBOX, 0, gid())
    os.chmod(OUTBOX, 0o750)
    for old in os.listdir(OUTBOX):  # держим только один файл
        os.remove(os.path.join(OUTBOX, old))
    dest = os.path.join(OUTBOX, name)
    src_fd = os.open(os.path.join(path, name), os.O_RDONLY | os.O_NOFOLLOW)
    dst_fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640)
    with os.fdopen(src_fd, "rb") as a, os.fdopen(dst_fd, "wb") as b:
        shutil.copyfileobj(a, b)
    os.chown(dest, 0, gid())
    print(json.dumps({"file": dest, "size": size}))


# ---------- обновление ----------

def repo() -> str:
    try:
        with open(REPO_FILE, encoding="utf-8") as f:
            r = f.read().strip()
    except OSError:
        r = DEFAULT_REPO
    if not REPO_RE.match(r):
        die("bad repo in " + REPO_FILE)
    return r


def write_result(data: dict) -> None:
    data["finished"] = time.time()
    tmp = RESULT_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, RESULT_FILE)


def code_items(root: str) -> list[str]:
    """Что считается кодом бота: *.py в корне, служебные файлы, tests/ и deploy/. Без config.yaml и venv."""
    items = [n for n in sorted(os.listdir(root)) if n.endswith(".py") and os.path.isfile(os.path.join(root, n))]
    items += [n for n in CODE_FILES + CODE_DIRS if os.path.exists(os.path.join(root, n))]
    return items


def copy_code(src: str, dst: str, group: int) -> None:
    for name in code_items(src):
        s, d = os.path.join(src, name), os.path.join(dst, name)
        if os.path.isdir(s):
            if os.path.isdir(d) and not os.path.islink(d):
                shutil.rmtree(d)
            shutil.copytree(s, d, symlinks=False, ignore=shutil.ignore_patterns("__pycache__"))
        else:
            shutil.copyfile(s, d)
    for base, dirs, files in os.walk(dst):
        if base.startswith(os.path.join(dst, "venv")):
            continue
        for n in dirs:
            if n != "venv":
                os.chown(os.path.join(base, n), 0, group)
                os.chmod(os.path.join(base, n), 0o755)
        for n in files:
            p = os.path.join(base, n)
            if os.path.islink(p) or n == "config.yaml":
                continue
            if base == dst and n not in code_items(dst):
                continue
            os.chown(p, 0, group)
            os.chmod(p, 0o755 if n == "monitor-bot-action" else 0o644)


def same_config(a: str, b: str) -> bool:
    """Совпадают ли файлы без учёта комментариев и пустых строк (у установленной копии их могли убрать)."""
    def lines(p: str) -> list[str]:
        with open(p, encoding="utf-8", errors="replace") as f:
            return [ln.strip() for ln in f if ln.strip() and not ln.lstrip().startswith("#")]
    if filecmp.cmp(a, b, shallow=False):
        return True
    if a.endswith("monitor-bot-action") or b.endswith("monitor-bot-action"):
        return False  # у программы и комментарии — часть файла, сравниваем точно
    return lines(a) == lines(b)


def download(sha: str, dest_dir: str) -> str:
    url = f"https://codeload.github.com/{repo()}/tar.gz/{sha}"
    archive = os.path.join(dest_dir, "src.tar.gz")
    req = urllib.request.Request(url, headers={"User-Agent": "monitor-bot-updater"})
    with urllib.request.urlopen(req, timeout=120) as r, open(archive, "wb") as f:
        shutil.copyfileobj(r, f)
    out = os.path.join(dest_dir, "src")
    with tarfile.open(archive) as t:
        t.extractall(out, filter="data")
    tops = os.listdir(out)
    if len(tops) != 1:
        raise RuntimeError("unexpected archive layout")
    return os.path.join(out, tops[0])


def service_state() -> tuple[str, int]:
    r = run(["systemctl", "show", SERVICE, "-p", "ActiveState", "-p", "NRestarts"])
    props = dict(ln.split("=", 1) for ln in r.stdout.splitlines() if "=" in ln)
    try:
        n = int(props.get("NRestarts", "0"))
    except ValueError:
        n = 0
    return props.get("ActiveState", "unknown"), n


def healthy_after_restart() -> tuple[bool, str]:
    run(["systemctl", "restart", SERVICE], timeout=120)
    time.sleep(SETTLE_SEC)
    state, restarts = service_state()
    if state == "active" and restarts == 0:
        return True, "active"
    return False, f"{state}, автоперезапусков {restarts}"


def read_version() -> dict:
    try:
        with open(os.path.join(APP_DIR, "VERSION"), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def update_run(sha: str) -> None:
    """Выполняется в отдельной службе systemd, чтобы перезапуск бота её не убил."""
    if not SHA_RE.match(sha):
        die("bad sha")
    try:
        lock = os.open(LOCK_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        die("update already running", 1)
    old = read_version()
    result = {"sha": sha, "from": old.get("sha"), "ok": False, "stage": "download", "notes": []}
    group = gid()
    try:
        with tempfile.TemporaryDirectory(prefix="monitor-bot-update-") as tmp:
            os.chmod(tmp, 0o755)
            src = download(sha, tmp)
            for base, dirs, files in os.walk(tmp):  # тесты идут от пользователя бота
                for n in dirs:
                    os.chmod(os.path.join(base, n), 0o755)
                for n in files:
                    os.chmod(os.path.join(base, n), 0o644)
            result["stage"] = "tests"
            r = subprocess.run(["runuser", "-u", BOT_GROUP, "--", VENV_PY, "-m", "unittest", "discover", "tests"],
                               cwd=src, capture_output=True, text=True, timeout=600)
            tail = (r.stderr or r.stdout).strip().splitlines()[-3:]
            result["tests"] = " ".join(tail)[-300:]
            if r.returncode != 0:
                result["error"] = "тесты новой версии не прошли, ничего не менял"
                return
            result["stage"] = "backup"
            bak = os.path.join(os.path.dirname(APP_DIR), "monitor_bot.bak-update-" + time.strftime("%Y%m%d-%H%M%S"))
            os.makedirs(bak)
            for name in code_items(APP_DIR) + (["VERSION"] if os.path.exists(os.path.join(APP_DIR, "VERSION")) else []):
                s_, d_ = os.path.join(APP_DIR, name), os.path.join(bak, name)
                if os.path.isdir(s_):
                    shutil.copytree(s_, d_, symlinks=True, ignore=shutil.ignore_patterns("__pycache__"))
                else:
                    shutil.copy2(s_, d_)
            result["backup"] = bak
            old_req = os.path.join(APP_DIR, "requirements.txt")
            req_changed = not (os.path.exists(old_req) and filecmp.cmp(old_req, os.path.join(src, "requirements.txt"),
                                                                     shallow=False))
            result["stage"] = "install"
            copy_code(src, APP_DIR, group)
            if req_changed:
                r = run([os.path.join(APP_DIR, "venv/bin/pip"), "install", "-q", "-r",
                         os.path.join(APP_DIR, "requirements.txt")], timeout=900)
                result["notes"].append("зависимости обновлены" if r.returncode == 0 else
                                       "pip install не удался: " + (r.stderr or r.stdout).strip()[-200:])
            ver = os.path.join(APP_DIR, "VERSION")
            fd = os.open(ver, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump({"sha": sha, "installed": time.time()}, f)
            os.chown(ver, 0, group)
            for rel, installed in NOT_AUTO:
                new = os.path.join(src, rel)
                if os.path.exists(new) and os.path.exists(installed) and not same_config(new, installed):
                    result["notes"].append(f"{installed} изменился в новой версии, его нужно обновить вручную")
            result["stage"] = "restart"
            ok, state = healthy_after_restart()
            if ok:
                result["ok"] = True
                result["stage"] = "done"
                return
            result["error"] = f"новая версия не запустилась ({state}), вернул прежнюю"
            for name in code_items(APP_DIR):  # откат: удалить новое, вернуть старое
                p = os.path.join(APP_DIR, name)
                if not os.path.exists(os.path.join(bak, name)):
                    shutil.rmtree(p) if os.path.isdir(p) else os.remove(p)
            copy_code(bak, APP_DIR, group)
            if os.path.exists(os.path.join(bak, "VERSION")):
                shutil.copy2(os.path.join(bak, "VERSION"), ver)
            ok2, state2 = healthy_after_restart()
            result["stage"] = "rolled_back" if ok2 else "rollback_failed"
            if not ok2:
                result["error"] += f"; после отката бот тоже не запустился ({state2})"
    except Exception as e:  # noqa: BLE001
        result["error"] = f"{result['stage']}: {e}"[:300]
    finally:
        write_result(result)
        os.close(lock)
        os.remove(LOCK_FILE)


def update(sha: str) -> None:
    if not SHA_RE.match(sha):
        die("bad sha")
    if os.path.exists(LOCK_FILE):
        die("update already running", 1)
    unit = "monitor-bot-update-" + sha[:7]
    r = run(["systemd-run", f"--unit={unit}", "--collect", "--quiet", "/usr/bin/python3", "-I",
             os.path.realpath(__file__), "update-run", sha], timeout=30)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "systemd-run failed", 1)
    print(f"started {unit}")


def bak_dirs() -> list[tuple[str, float]]:
    parent = os.path.dirname(APP_DIR)
    out = []
    for n in os.listdir(parent):
        p = os.path.join(parent, n)
        if BAK_RE.match(n) and os.path.isdir(p) and not os.path.islink(p):
            out.append((p, os.lstat(p).st_mtime))
    return sorted(out, key=lambda x: x[1], reverse=True)


def bak_list() -> None:
    print(json.dumps([{"path": p, "mtime": m, "size": du_bytes(p)} for p, m in bak_dirs()]))


def prune_bak(keep_s: str) -> None:
    if not keep_s.isdigit() or not 1 <= int(keep_s) <= 20:
        die("bad keep")
    freed, removed = 0, []
    for p, _ in bak_dirs()[int(keep_s):]:
        if os.path.dirname(os.path.realpath(p)) != os.path.dirname(APP_DIR):
            continue
        freed += du_bytes(p)
        shutil.rmtree(p)
        removed.append(os.path.basename(p))
    print(json.dumps({"removed": removed, "freed": freed}))


# ---------- диск и фаервол ----------

def read_io() -> dict[int, tuple[str, int, int]]:
    out = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/io", encoding="utf-8") as f:
                vals = dict(ln.split(": ") for ln in f.read().splitlines() if ": " in ln)
            with open(f"/proc/{d}/comm", encoding="utf-8") as f:
                name = f.read().strip()
            out[int(d)] = (name, int(vals.get("read_bytes", 0)), int(vals.get("write_bytes", 0)))
        except (OSError, ValueError):
            continue
    return out


def io_top() -> None:
    a = read_io()
    time.sleep(2)
    b = read_io()
    rows = []
    for pid, (name, r, w) in b.items():
        if pid in a:
            dr, dw = r - a[pid][1], w - a[pid][2]
            if dr or dw:
                rows.append({"pid": pid, "name": name, "read": dr / 2, "write": dw / 2})
    rows.sort(key=lambda x: x["read"] + x["write"], reverse=True)
    print(json.dumps(rows[:10], ensure_ascii=False))


def parse_ip(s: str):
    try:
        ip = ipaddress.ip_address(s)
    except ValueError:
        die("bad ip")
    if ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified or ip.is_reserved:
        die("refused: local or special address")
    return ip


def ssh_peers() -> set[str]:
    """IP, с которых сейчас открыты SSH-сессии: их не блокируем, чтобы не отрезать себя."""
    r = run(["ss", "-H", "-tn", "state", "established", "( sport = :22 )"])
    peers = set()
    for ln in r.stdout.splitlines():
        parts = ln.split()
        if len(parts) >= 4:
            addr = parts[-1].rpartition(":")[0].strip("[]")
            peers.add(addr.removeprefix("::ffff:"))
    return peers


def ufw_active() -> bool:
    r = run(["ufw", "status"])
    return r.returncode == 0 and "Status: active" in r.stdout


def banned() -> list[str]:
    r = run(["ufw", "status"])
    ips = []
    for ln in r.stdout.splitlines():
        if "DENY" in ln and f"# {BAN_COMMENT}" in ln:
            tokens = ln.split("DENY", 1)[1].split()  # «Anywhere  DENY  203.0.113.5  # monitor-bot»
            if tokens and tokens[0] == "IN":
                tokens = tokens[1:]
            src = tokens[0] if tokens and tokens[0] != "#" else ""
            if src and src not in ips:
                ips.append(src)
    return ips


def ban_ip(s: str) -> None:
    ip = parse_ip(s)
    if str(ip) in ssh_peers():
        die("refused: this IP has an open SSH session")
    if not ufw_active():
        die("ufw is not active", 1)
    if str(ip) in banned():
        print(f"already banned {ip}")
        return
    r = run(["ufw", "insert", "1", "deny", "from", str(ip), "to", "any", "comment", BAN_COMMENT])
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "ufw failed", 1)
    print(f"banned {ip}")


def unban_ip(s: str) -> None:
    ip = parse_ip(s)
    if str(ip) not in banned():
        die("not banned by monitor-bot", 1)
    r = run(["ufw", "delete", "deny", "from", str(ip), "to", "any", "comment", BAN_COMMENT])
    if r.returncode != 0:
        r = run(["ufw", "delete", "deny", "from", str(ip), "to", "any"])
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "ufw failed", 1)
    print(f"unbanned {ip}")


def reboot() -> None:
    subprocess.Popen(["systemctl", "reboot"])
    print("rebooting")


def main(argv: list[str]) -> None:
    if not argv:
        die(__doc__)
    cmd, args = argv[0], argv[1:]
    if cmd == "restart-service" and len(args) == 1:
        restart_service(args[0])
    elif cmd == "kill" and len(args) == 1:
        kill(args[0])
    elif cmd == "cleanup-estimate" and not args:
        cleanup_estimate()
    elif cmd == "cleanup" and not args:
        cleanup()
    elif cmd == "reboot" and not args:
        reboot()
    elif cmd == "backup-status" and not args:
        backup_status()
    elif cmd == "backup-fetch" and len(args) == 1:
        backup_fetch(args[0])
    elif cmd == "update" and len(args) == 1:
        update(args[0])
    elif cmd == "update-run" and len(args) == 1:
        update_run(args[0])
    elif cmd == "bak-list" and not args:
        bak_list()
    elif cmd == "prune-bak" and len(args) == 1:
        prune_bak(args[0])
    elif cmd == "io-top" and not args:
        io_top()
    elif cmd == "ban-ip" and len(args) == 1:
        ban_ip(args[0])
    elif cmd == "unban-ip" and len(args) == 1:
        unban_ip(args[0])
    elif cmd == "banned-list" and not args:
        print(json.dumps(banned()))
    else:
        die("unknown command")


if __name__ == "__main__":
    main(sys.argv[1:])
