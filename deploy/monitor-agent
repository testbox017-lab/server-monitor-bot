#!/usr/bin/python3 -I
"""Агент на втором (удалённом) сервере: отдаёт его состояние главному боту одним JSON.

Устанавливается как /usr/local/sbin/monitor-agent (root:root, 755). Только стандартная библиотека Python.
Главный бот заходит по SSH отдельным ключом, который в /root/.ssh/authorized_keys ограничен так:
    command="/usr/local/sbin/monitor-agent",restrict ssh-ed25519 AAAA... monitor-bot@главный-сервер
Поэтому по этому ключу нельзя получить оболочку или запустить что-то ещё: ssh-команда приходит
в SSH_ORIGINAL_COMMAND, и агент понимает только:
    status [SVC,SVC...] [since=TS]
                          — CPU, память, диски, нагрузка, аптайм, нужна ли перезагрузка, состояние
                            перечисленных служб systemd и всех контейнеров docker, открытые порты,
                            блокировки fail2ban; с since — строки sshd о входах и неудачных попытках
                            с момента TS (без входов самого бота по ключу агента)
                            и строки с ошибками из логов работающих контейнеров (ctr_logs)
    logs / restart / ban / unban / reboot / backups / backup-get — действия из бота, ровно в видах
                            из parse_action(). Перезапуск служб — только из /etc/monitor-agent/allowed-services,
                            копии — только из папок /etc/monitor-agent/backup-watch.
"""
import base64
import hashlib
import ipaddress
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import time

SVC_RE = re.compile(r"^[A-Za-z0-9@_.:-]{1,100}$")
SKIP_FS = {"tmpfs", "devtmpfs", "squashfs", "overlay", "proc", "sysfs", "cgroup", "cgroup2", "devpts",
           "mqueue", "debugfs", "tracefs", "securityfs", "pstore", "bpf", "configfs", "fusectl",
           "hugetlbfs", "autofs", "binfmt_misc", "efivarfs", "nsfs", "ramfs", "rpc_pipefs", "fuse.lxcfs"}
PS_FMT = "{{.Names}}\t{{.State}}\t{{.Status}}"


def cpu_times(text: str) -> tuple[int, int]:
    """(простой, всего) из первой строки /proc/stat."""
    f = [int(x) for x in text.split("\n", 1)[0].split()[1:]]
    idle = f[3] + (f[4] if len(f) > 4 else 0)
    return idle, sum(f[:8])


def cpu_percent(interval: float = 1.0) -> float:
    with open("/proc/stat") as fh:
        i1, t1 = cpu_times(fh.read())
    time.sleep(interval)
    with open("/proc/stat") as fh:
        i2, t2 = cpu_times(fh.read())
    dt = t2 - t1
    return round(100.0 * (1 - (i2 - i1) / dt), 1) if dt > 0 else 0.0


def meminfo(text: str) -> dict:
    """RAM и swap в байтах и процентах из /proc/meminfo."""
    m = {}
    for line in text.splitlines():
        k, _, v = line.partition(":")
        parts = v.split()
        if parts and parts[0].isdigit():
            m[k] = int(parts[0]) * 1024
    total = m.get("MemTotal", 0)
    avail = m.get("MemAvailable", m.get("MemFree", 0))
    used = total - avail
    st, sf = m.get("SwapTotal", 0), m.get("SwapFree", 0)
    return {"ram": {"total": total, "used": used, "percent": round(100.0 * used / total, 1) if total else 0.0},
            "swap": {"total": st, "used": st - sf, "percent": round(100.0 * (st - sf) / st, 1) if st else 0.0}}


def mounts(text: str) -> list[str]:
    """Точки монтирования настоящих дисков из /proc/mounts."""
    out = []
    for line in text.splitlines():
        p = line.split()
        if len(p) < 3 or p[2] in SKIP_FS or not p[0].startswith("/"):
            continue
        path = p[1].replace("\\040", " ")
        if path.startswith(("/snap/", "/boot/efi", "/run/", "/proc", "/sys", "/dev")):
            continue
        out.append(path)
    return sorted(set(out))


def disks() -> dict:
    with open("/proc/mounts") as fh:
        paths = mounts(fh.read())
    res = {}
    for p in paths:
        try:
            u = shutil.disk_usage(p)
        except OSError:
            continue
        if u.total:
            res[p] = {"total": u.total, "used": u.used, "free": u.free, "percent": round(100.0 * u.used / u.total, 1)}
    return res


def service_state(name: str) -> str:
    try:
        r = subprocess.run(["systemctl", "show", name, "--property=ActiveState,SubState,LoadState"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    p = dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)
    if p.get("LoadState") == "not-found":
        return "not-found"
    if p.get("ActiveState") == "active":
        return "running" if p.get("SubState") in ("running", "exited", "listening", "mounted") else p.get("SubState", "?")
    return p.get("ActiveState", "unknown")


def parse_ps(text: str) -> dict:
    """{имя: {state, health}} из docker ps -a --format PS_FMT."""
    res = {}
    for line in text.splitlines():
        p = line.split("\t")
        if len(p) < 2 or not p[0]:
            continue
        status = p[2] if len(p) > 2 else ""
        health = ("unhealthy" if "(unhealthy)" in status else "healthy" if "(healthy)" in status
                  else "starting" if "(health: starting)" in status else "")
        res[p[0]] = {"state": p[1], "health": health}
    return res


INSPECT_FMT = "{{.Name}}\t{{.RestartCount}}\t{{.State.StartedAt}}"


def parse_inspect(text: str) -> dict:
    """{имя: {restarts, started}} из docker inspect -f INSPECT_FMT."""
    res = {}
    for line in text.splitlines():
        p = line.split("\t")
        if len(p) < 3 or not p[0]:
            continue
        try:
            restarts = int(p[1])
        except ValueError:
            restarts = 0
        res[p[0].lstrip("/")] = {"restarts": restarts, "started": p[2]}
    return res


def containers() -> dict | None:
    """None — docker не установлен или не отвечает. Для каждого: state, health, restarts, started."""
    if not shutil.which("docker"):
        return None
    try:
        r = subprocess.run(["docker", "ps", "-a", "--format", PS_FMT], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    res = parse_ps(r.stdout)
    names = [n for n in res if CTR_RE.match(n)]
    if names:
        try:
            ri = subprocess.run(["docker", "inspect", "-f", INSPECT_FMT, *names], capture_output=True, text=True,
                                timeout=20)
            for n, extra in parse_inspect(ri.stdout).items():
                if n in res:
                    res[n].update(extra)
        except (OSError, subprocess.TimeoutExpired):
            pass
    return res


# Строки логов контейнеров, которые стоит показать главному боту: ошибки и признаки сбоя сети.
LOG_WORDS = ("Traceback", "ERROR", "CRITICAL", "Exception", "FATAL", "Error", "Timeout", "TimedOut",
             "Connection reset", "Temporary failure in name resolution", "Network is unreachable",
             "Bad Gateway", "Gateway Timeout", "Service Unavailable")
LOG_MAX_LINES = 100


def log_hits(text: str) -> list[str]:
    """Строки с LOG_WORDS, не больше LOG_MAX_LINES последних, каждая не длиннее 300 символов."""
    return [ln.strip()[:300] for ln in text.splitlines() if any(w in ln for w in LOG_WORDS)][-LOG_MAX_LINES:]


def ctr_logs(since: int, ctrs: dict | None) -> dict | None:
    """{контейнер: [строки с ошибками]} с момента since — по всем работающим контейнерам."""
    if not ctrs:
        return None
    out = {}
    for name, info in ctrs.items():
        if info.get("state") != "running" or not CTR_RE.match(name):
            continue
        try:
            r = subprocess.run(["docker", "logs", "--since", str(int(since)), name], capture_output=True, text=True,
                               timeout=20, errors="replace")
        except (OSError, subprocess.TimeoutExpired):
            continue
        out[name] = log_hits(r.stdout + "\n" + r.stderr)
    return out


def parse_cmd(cmd: str) -> tuple[list[str], int | None] | None:
    """(службы, since) из команды «status [a,b] [since=TS]». None — команда не разрешена."""
    p = cmd.split()
    if not p or p[0] != "status" or len(p) > 3:
        return None
    names, since = [], None
    for tok in p[1:]:
        if tok.startswith("since="):
            if since is not None or not tok[6:].isdigit():
                return None
            since = int(tok[6:])
        elif not names:
            names = [x for x in tok.split(",") if x]
            if not names:
                return None
        else:
            return None
    if len(names) > 50 or not all(SVC_RE.match(x) for x in names):
        return None
    return names, since


# ---------- SSH ----------

SSH_WORDS = ("Accepted ", "Failed ", "Invalid user ", "[preauth]")
SSH_MAX_LINES = 5000


def key_fingerprint(blob_b64: str) -> str:
    """SHA256:… как в журнале sshd, по base64 ключа из authorized_keys."""
    raw = base64.b64decode(blob_b64)
    return "SHA256:" + base64.b64encode(hashlib.sha256(raw).digest()).decode().rstrip("=")


def own_fingerprints(text: str) -> set[str]:
    """Отпечатки ключей, которые запускают этого агента: их входы — это сам главный бот, не человек."""
    out = set()
    for line in text.splitlines():
        if "monitor-agent" not in line.split(" ssh-", 1)[0]:
            continue
        parts = line.split()
        for i, w in enumerate(parts[:-1]):
            if w.startswith(("ssh-", "ecdsa-")):
                try:
                    out.add(key_fingerprint(parts[i + 1]))
                except ValueError:
                    pass
                break
    return out


def ssh_lines(text: str, skip_fps: set[str]) -> list[str]:
    """Строки sshd о входах и неудачных попытках, без входов самого бота; не больше SSH_MAX_LINES последних."""
    out = []
    for line in text.splitlines():
        line = line.strip()
        if not any(w in line for w in SSH_WORDS):
            continue
        if line.startswith("Accepted ") and any(line.endswith(fp) for fp in skip_fps):
            continue
        out.append(line)
    return out[-SSH_MAX_LINES:]


def ssh_log(since: int) -> list[str] | None:
    try:
        r = subprocess.run(["journalctl", "-u", "ssh.service", "-u", "sshd.service", "--since", f"@{since}",
                            "-o", "cat", "--no-pager"], capture_output=True, text=True, timeout=30,
                           errors="replace")
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    try:
        with open("/root/.ssh/authorized_keys") as fh:
            fps = own_fingerprints(fh.read())
    except OSError:
        fps = set()
    return ssh_lines(r.stdout, fps)


def listening_ports(text: str) -> list[str]:
    """«tcp/22», «udp/53» из ss -H -tuln: открытые не только на localhost."""
    ports = set()
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 5:
            continue
        addr, _, port = parts[4].rpartition(":")
        addr = addr.strip("[]").split("%")[0]
        if addr.startswith("127.") or addr == "::1":
            continue
        ports.add(f"{parts[0]}/{port}")
    return sorted(ports)


def ports() -> list[str] | None:
    try:
        r = subprocess.run(["ss", "-H", "-tuln"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return listening_ports(r.stdout) if r.returncode == 0 else None


def parse_f2b(text: str) -> dict:
    """Из «fail2ban-client status JAIL»: сколько заблокировано сейчас и всего, и список IP."""
    res = {"banned": 0, "total": 0, "ips": []}
    for line in text.splitlines():
        k, _, v = line.strip(" |`-\t").partition(":")
        v = v.strip()
        if k == "Currently banned" and v.isdigit():
            res["banned"] = int(v)
        elif k == "Total banned" and v.isdigit():
            res["total"] = int(v)
        elif k == "Banned IP list":
            res["ips"] = v.split()[:100]
    return res


def fail2ban() -> dict | None:
    """{jail: {...}} по всем jail fail2ban; None — fail2ban не установлен."""
    if not shutil.which("fail2ban-client"):
        return None
    try:
        r = subprocess.run(["fail2ban-client", "status"], capture_output=True, text=True, timeout=10)
        jails = []
        for line in r.stdout.splitlines():
            if "Jail list:" in line:
                jails = [j.strip() for j in line.split(":", 1)[1].split(",") if j.strip()]
        out = {}
        for j in jails[:10]:
            if re.match(r"^[A-Za-z0-9_.-]+$", j):
                rj = subprocess.run(["fail2ban-client", "status", j], capture_output=True, text=True, timeout=10)
                out[j] = parse_f2b(rj.stdout)
        return out
    except (OSError, subprocess.TimeoutExpired):
        return None


def net_counters(text: str) -> dict:
    """Принято и отправлено байт по всем интерфейсам, кроме lo, из /proc/net/dev."""
    rx = tx = 0
    for line in text.splitlines()[2:]:
        name, _, rest = line.partition(":")
        f = rest.split()
        if name.strip() == "lo" or len(f) < 9:
            continue
        rx += int(f[0])
        tx += int(f[8])
    return {"rx": rx, "tx": tx}


def allowed_services() -> list[str]:
    """Службы, которые можно перезапускать из бота: по одной в строке, # — комментарий."""
    try:
        with open(ALLOWED_SERVICES) as fh:
            names = [ln.split("#", 1)[0].strip() for ln in fh]
    except OSError:
        return []
    return [n for n in names if n and SVC_RE.match(n)]


def status(services: list[str], since: int | None = None) -> dict:
    with open("/proc/meminfo") as fh:
        mem = meminfo(fh.read())
    with open("/proc/uptime") as fh:
        uptime = float(fh.read().split()[0])
    try:
        with open("/proc/net/dev") as fh:
            net = net_counters(fh.read())
    except OSError:
        net = None
    ctrs = containers()
    return {
        "v": 3,
        "host": platform.node(),
        "os": f"{platform.system()} {platform.release()}",
        "time": time.time(),
        "cpu": cpu_percent(),
        "cpu_count": os.cpu_count() or 1,
        "load": list(os.getloadavg()),
        **mem,
        "disks": disks(),
        "net": net,
        "uptime": uptime,
        "reboot_required": os.path.exists("/run/reboot-required") or os.path.exists("/var/run/reboot-required"),
        "services": {s: service_state(s) for s in services},
        "containers": ctrs,
        "ctr_logs": ctr_logs(since, ctrs) if since else None,
        "ssh": ssh_log(since) if since else None,
        "ports": ports(),
        "fail2ban": fail2ban(),
        "allowed_services": allowed_services(),
        "apt_running": apt_running(),
    }


# ---------- Действия ----------

ALLOWED_SERVICES = "/etc/monitor-agent/allowed-services"
CTR_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")
F2B_JAIL = "sshd"


def _run(cmd: list[str], timeout: int) -> dict:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, errors="replace")
    except subprocess.TimeoutExpired:
        return {"ok": False, "out": "timeout"}
    except OSError as e:
        return {"ok": False, "out": str(e)}
    return {"ok": r.returncode == 0, "out": (r.stdout + r.stderr).strip()[-6000:]}


def caller_ip() -> str:
    """IP, с которого пришла эта SSH-сессия (главный сервер): его нельзя заблокировать."""
    return os.environ.get("SSH_CLIENT", "").split(" ")[0]


def bannable(ip: str) -> str | None:
    """Нормализованный публичный IP или None."""
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return None
    if a.is_private or a.is_loopback or a.is_link_local or a.is_multicast or a.is_unspecified or a.is_reserved:
        return None
    return str(a)


# ---------- Процессы и обновления (только чтение) ----------

def _proc_ticks() -> dict:
    out = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as fh:
                s = fh.read()
            name = s[s.index("(") + 1:s.rindex(")")]
            f = s[s.rindex(")") + 2:].split()
            with open(f"/proc/{d}/statm") as fh:
                rss = int(fh.read().split()[1]) * os.sysconf("SC_PAGE_SIZE")
            out[int(d)] = (name, int(f[11]) + int(f[12]), rss)
        except (OSError, ValueError, IndexError):
            continue
    return out


def top_procs(by: str, n: int, interval: float = 1.0) -> list[dict]:
    """[{pid, name, cpu, rss}] — самые нагружающие процессы (CPU за interval секунд или память)."""
    a = _proc_ticks()
    time.sleep(interval)
    b = _proc_ticks()
    hz = os.sysconf("SC_CLK_TCK")
    rows = []
    for pid, (name, ticks, rss) in b.items():
        prev = a.get(pid)
        cpu = 100.0 * (ticks - prev[1]) / hz / interval if prev and prev[0] == name else 0.0
        rows.append({"pid": pid, "name": name, "cpu": round(cpu, 1), "rss": rss})
    rows.sort(key=lambda r: r["cpu" if by == "cpu" else "rss"], reverse=True)
    return rows[:n]


def parse_upgradable(text: str) -> list[dict]:
    """«pkg/noble-security 1.2 amd64 [upgradable from: 1.1]» → [{name, security}]."""
    out = []
    for line in text.splitlines():
        if "/" not in line or "upgradable" not in line:
            continue
        name, _, rest = line.partition("/")
        out.append({"name": name.strip(), "security": "-security" in rest.split(" ", 1)[0]})
    return out


def upgradable() -> dict:
    r = _run(["apt", "list", "--upgradable"], 60)
    return {"ok": r["ok"], "out": json.dumps(parse_upgradable(r["out"])) if r["ok"] else r["out"]}


APT_UNIT = "monitor-agent-apt"


def apt_running() -> bool:
    r = _run(["systemctl", "is-active", APT_UNIT], 10)
    return r["out"].strip() in ("active", "activating")


def apt_upgrade(mode: str) -> dict:
    """Установка обновлений в отдельной службе systemd (переживёт обрыв SSH). security — unattended-upgrade
    (только обновления безопасности), all — apt-get upgrade без удаления пакетов."""
    if apt_running():
        return {"ok": False, "out": "package upgrade is already running"}
    if mode == "security":
        script = "apt-get update -q && unattended-upgrade -v"
    else:
        script = ("apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get -y -q "
                  "-o Dpkg::Options::=--force-confold upgrade")
    _run(["systemctl", "reset-failed", APT_UNIT], 10)
    return _run(["systemd-run", f"--unit={APT_UNIT}", "--collect", "sh", "-c",
                 f"{script} > /var/log/monitor-agent-apt.log 2>&1"], 30)


# ---------- Резервные копии (главный бот забирает себе последнюю копию из каждой папки) ----------

BACKUP_WATCH = "/etc/monitor-agent/backup-watch"
BACKUP_MAX = 50 << 20  # больше 50 МБ через SSH в JSON не передаём


def backup_dirs() -> list[str]:
    """Папки с копиями из BACKUP_WATCH: путь в начале строки (дальше можно писать что угодно), # — комментарий."""
    try:
        with open(BACKUP_WATCH, encoding="utf-8") as fh:
            lines = [ln.split("#", 1)[0].split() for ln in fh]
    except OSError:
        return []
    return [os.path.normpath(p[0]) for p in lines if p and os.path.isabs(p[0])]


def newest_backup(path: str) -> tuple[str, int, float] | None:
    """(имя, размер, mtime) самой свежей копии; latest.* — копия последней, её не берём, если есть другие."""
    files = []
    try:
        with os.scandir(path) as it:
            for e in it:
                if e.is_file(follow_symlinks=False):
                    st = e.stat(follow_symlinks=False)
                    files.append((e.name, st.st_size, st.st_mtime))
    except OSError:
        return None
    files.sort(key=lambda x: x[2], reverse=True)
    dated = [f for f in files if not f[0].startswith("latest")] or files
    return dated[0] if dated else None


def backups_list() -> dict:
    return {"ok": True, "out": json.dumps([{"path": p, "newest": newest_backup(p)} for p in backup_dirs()])}


def backup_get(n: int) -> dict:
    """Последняя копия из n-й папки: JSON {name, size, mtime, b64} в out."""
    dirs = backup_dirs()
    if n >= len(dirs):
        return {"ok": False, "out": "bad index"}
    nb = newest_backup(dirs[n])
    if nb is None:
        return {"ok": False, "out": "no backups"}
    name, size, mtime = nb
    if size > BACKUP_MAX:
        return {"ok": False, "out": f"too big: {size}"}
    try:
        fd = os.open(os.path.join(dirs[n], name), os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as fh:
            data = fh.read(BACKUP_MAX + 1)
    except OSError as e:
        return {"ok": False, "out": str(e)}
    return {"ok": True, "out": json.dumps({"name": name, "size": len(data), "mtime": mtime,
                                           "b64": base64.b64encode(data).decode()})}


def parse_action(cmd: str) -> list[str] | None:
    """Разрешённые действия, ровно в этих видах:
        logs svc|ctr NAME N      — последние N (1–200) строк журнала службы или контейнера
        restart svc NAME         — только службы из /etc/monitor-agent/allowed-services
        restart ctr NAME         — docker restart
        ban IP / unban IP        — fail2ban (jail sshd); не локальные адреса и не адрес главного сервера
        procs cpu|mem N          — N (1–30) самых нагружающих процессов (JSON в out)
        updates                  — пакеты, которые можно обновить (JSON в out)
        apt-upgrade security|all — установить обновления в фоне (служба monitor-agent-apt)
        reboot                   — перезагрузка через 5 секунд
        backups                  — папки из /etc/monitor-agent/backup-watch и свежая копия в каждой (JSON)
        backup-get N             — последняя копия из N-й папки (JSON с base64)
    """
    p = cmd.split()
    if not p:
        return None
    if p == ["backups"]:
        return p
    if p[0] == "backup-get" and len(p) == 2 and p[1].isdigit() and int(p[1]) < 100:
        return p
    if p[0] == "logs" and len(p) == 4 and p[1] in ("svc", "ctr") and p[3].isdigit() and 1 <= int(p[3]) <= 200:
        ok = SVC_RE.match(p[2]) if p[1] == "svc" else CTR_RE.match(p[2])
        return p if ok else None
    if p[0] == "restart" and len(p) == 3 and p[1] == "svc" and SVC_RE.match(p[2]):
        return p
    if p[0] == "restart" and len(p) == 3 and p[1] == "ctr" and CTR_RE.match(p[2]):
        return p
    if p[0] in ("ban", "unban") and len(p) == 2 and bannable(p[1]):
        return p
    if p[0] == "procs" and len(p) == 3 and p[1] in ("cpu", "mem") and p[2].isdigit() and 1 <= int(p[2]) <= 30:
        return p
    if p[0] == "apt-upgrade" and len(p) == 2 and p[1] in ("security", "all"):
        return p
    if p == ["updates"]:
        return p
    if p == ["reboot"]:
        return p
    return None


def action(p: list[str]) -> dict:
    if p == ["backups"]:
        return backups_list()
    if p[0] == "backup-get":
        return backup_get(int(p[1]))
    if p[0] == "logs":
        if p[1] == "svc":
            return _run(["journalctl", "-u", p[2], "-n", p[3], "--no-pager", "-o", "short-iso"], 30)
        if not shutil.which("docker"):
            return {"ok": False, "out": "docker is not installed"}
        return _run(["docker", "logs", "--tail", p[3], p[2]], 30)
    if p[0] == "restart" and p[1] == "svc":
        if p[2] not in allowed_services():
            return {"ok": False, "out": f"service not allowed (add it to {ALLOWED_SERVICES})"}
        return _run(["systemctl", "restart", p[2]], 150)
    if p[0] == "restart":
        if not shutil.which("docker"):
            return {"ok": False, "out": "docker is not installed"}
        return _run(["docker", "restart", p[2]], 120)
    if p[0] in ("ban", "unban"):
        ip = bannable(p[1])
        if p[0] == "ban" and ip == bannable(caller_ip()):
            return {"ok": False, "out": "refused: this is the main server address"}
        if not shutil.which("fail2ban-client"):
            return {"ok": False, "out": "fail2ban is not installed"}
        if p[0] == "ban":
            return _run(["fail2ban-client", "set", F2B_JAIL, "banip", ip], 30)
        return _run(["fail2ban-client", "unban", ip], 30)
    if p[0] == "procs":
        return {"ok": True, "out": json.dumps(top_procs(p[1], int(p[2])))}
    if p[0] == "apt-upgrade":
        return apt_upgrade(p[1])
    if p == ["updates"]:
        return upgradable()
    if p == ["reboot"]:
        return _run(["systemd-run", "--on-active=5", "--unit=monitor-agent-reboot", "systemctl", "reboot"], 15)
    return {"ok": False, "out": "unknown command"}


def main() -> int:
    cmd = os.environ.get("SSH_ORIGINAL_COMMAND", " ".join(sys.argv[1:]))
    parsed = parse_cmd(cmd)
    if parsed is not None:
        print(json.dumps(status(*parsed)))
        return 0
    act = parse_action(cmd)
    if act is None:
        print(json.dumps({"error": "command not allowed"}))
        return 2
    res = action(act)
    print(json.dumps(res))
    return 0 if res["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
