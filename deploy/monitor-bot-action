def repo() -> str:
    try:
        with open(REPO_FILE, encoding="utf-8") as f:
            r = f.read().strip()
    except OSError:
        r = DEFAULT_REPO
    if not REPO_RE.match(r):
        die("bad repo in " + REPO_FILE)
    return r


def write_result(data: dict) -> None:
    data["finished"] = time.time()
    tmp = RESULT_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, RESULT_FILE)


def code_items(root: str) -> list[str]:
    """Что считается кодом бота: *.py в корне, служебные файлы, tests/ и deploy/. Без config.yaml и venv."""
    items = [n for n in sorted(os.listdir(root)) if n.endswith(".py") and os.path.isfile(os.path.join(root, n))]
    items += [n for n in CODE_FILES + CODE_DIRS if os.path.exists(os.path.join(root, n))]
    return items


def copy_code(src: str, dst: str, group: int) -> None:
    for name in code_items(src):
        s, d = os.path.join(src, name), os.path.join(dst, name)
        if os.path.islink(d):
            os.remove(d)  # не пишем через подложенную ссылку
        if os.path.isdir(s):
            if os.path.isdir(d):
                shutil.rmtree(d)
            shutil.copytree(s, d, symlinks=False, ignore=shutil.ignore_patterns("__pycache__"))
        else:
            shutil.copyfile(s, d, follow_symlinks=False)
    for base, dirs, files in os.walk(dst):
        if base.startswith(os.path.join(dst, "venv")):
            continue
        for n in dirs:
            if n != "venv":
                os.chown(os.path.join(base, n), 0, group)
                os.chmod(os.path.join(base, n), 0o755)
        for n in files:
            p = os.path.join(base, n)
            if os.path.islink(p) or n == "config.yaml":
                continue
            if base == dst and n not in code_items(dst):
                continue
            os.chown(p, 0, group)
            os.chmod(p, 0o755 if n == "monitor-bot-action" else 0o644)


def same_config(a: str, b: str) -> bool:
    """Совпадают ли файлы без учёта комментариев и пустых строк (у установленной копии их могли убрать)."""
    def lines(p: str) -> list[str]:
        with open(p, encoding="utf-8", errors="replace") as f:
            return [ln.strip() for ln in f if ln.strip() and not ln.lstrip().startswith("#")]
    if filecmp.cmp(a, b, shallow=False):
        return True
    if a.endswith("monitor-bot-action") or b.endswith("monitor-bot-action"):
        return False  # у программы и комментарии — часть файла, сравниваем точно
    return lines(a) == lines(b)


def github_api(path: str) -> dict:
    req = urllib.request.Request(f"https://api.github.com/{path}",
                                 headers={"User-Agent": "monitor-bot-updater", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode("utf-8"))


def check_in_main(sha: str, api_fn=None) -> None:
    """Ставим только коммиты, которые уже есть в ветке main. GitHub отдаёт по адресу репозитория и коммиты
    из чужих форков, поэтому без этой проверки можно было бы поставить чужой код."""
    d = (api_fn or github_api)(f"repos/{repo()}/compare/{UPDATE_BRANCH}...{sha}")
    if d.get("status") not in ("identical", "behind"):
        raise RuntimeError(f"коммит {sha[:7]} не входит в ветку {UPDATE_BRANCH} (status {d.get('status')})")


def unsafe_paths(root: str, limit: int = 5) -> list[str]:
    """Файлы и папки, которые принадлежат не root или доступны на запись группе/всем.
    Код из них выполняется от root (pip) или копируется root, поэтому так быть не должно."""
    bad = []
    for base, dirs, files in os.walk(root):
        for n in [""] + dirs + files:
            p = os.path.join(base, n) if n else base
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if stat.S_ISLNK(st.st_mode):
                continue  # ссылки в venv (bin/python → /usr/bin/python3) — нормально, права у ссылки не важны
            if st.st_uid != 0 or st.st_mode & 0o022:
                bad.append(p)
                if len(bad) >= limit:
                    return bad
    return bad


def check_ownership() -> None:
    bad = []
    for p in (os.path.dirname(APP_DIR), APP_DIR):
        st = os.lstat(p)
        if stat.S_ISLNK(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            bad.append(p)
    bad += unsafe_paths(os.path.join(APP_DIR, "venv"))
    if bad:
        raise RuntimeError("небезопасные права (нужен владелец root и запись только для root): "
                           + ", ".join(bad[:5]) + f". Исправить: chown -R root:root {APP_DIR}/venv; "
                           f"chown root:root {APP_DIR}; chmod go-w {APP_DIR}")


def pip_install(req: str) -> subprocess.CompletedProcess:
    # только готовые wheel: при сборке из исходников setup.py пакета выполнялся бы от root
    return run([os.path.join(APP_DIR, "venv/bin/pip"), "install", "-q", "--only-binary=:all:", "-r", req], timeout=900)


def download(sha: str, dest_dir: str) -> str:
    url = f"https://codeload.github.com/{repo()}/tar.gz/{sha}"
    archive = os.path.join(dest_dir, "src.tar.gz")
    req = urllib.request.Request(url, headers={"User-Agent": "monitor-bot-updater"})
    with urllib.request.urlopen(req, timeout=120) as r, open(archive, "wb") as f:
        shutil.copyfileobj(r, f)
    out = os.path.join(dest_dir, "src")
    with tarfile.open(archive) as t:
        t.extractall(out, filter="data")
    tops = os.listdir(out)
    if len(tops) != 1:
        raise RuntimeError("unexpected archive layout")
    return os.path.join(out, tops[0])


def service_state() -> tuple[str, int]:
    r = run(["systemctl", "show", SERVICE, "-p", "ActiveState", "-p", "NRestarts"])
    props = dict(ln.split("=", 1) for ln in r.stdout.splitlines() if "=" in ln)
    try:
        n = int(props.get("NRestarts", "0"))
    except ValueError:
        n = 0
    return props.get("ActiveState", "unknown"), n


def healthy_after_restart() -> tuple[bool, str]:
    run(["systemctl", "restart", SERVICE], timeout=120)
    time.sleep(SETTLE_SEC)
    state, restarts = service_state()
    if state == "active" and restarts == 0:
        return True, "active"
    return False, f"{state}, автоперезапусков {restarts}"


def read_version() -> dict:
    try:
        with open(os.path.join(APP_DIR, "VERSION"), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def update_run(sha: str) -> None:
    """Выполняется в отдельной службе systemd, чтобы перезапуск бота её не убил."""
    if not SHA_RE.match(sha):
        die("bad sha")
    try:
        lock = os.open(LOCK_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        die("update already running", 1)
    old = read_version()
    result = {"sha": sha, "from": old.get("sha"), "ok": False, "stage": "check", "notes": []}
    group = gid()
    try:
        check_ownership()
        check_in_main(sha)
        result["stage"] = "download"
        with tempfile.TemporaryDirectory(prefix="monitor-bot-update-") as tmp:
            os.chmod(tmp, 0o755)
            src = download(sha, tmp)
            for base, dirs, files in os.walk(tmp):  # тесты идут от пользователя бота
                for n in dirs:
                    os.chmod(os.path.join(base, n), 0o755)
                for n in files:
                    os.chmod(os.path.join(base, n), 0o644)
            result["stage"] = "tests"
            r = subprocess.run(["runuser", "-u", BOT_GROUP, "--", VENV_PY, "-m", "unittest", "discover", "tests"],
                               cwd=src, capture_output=True, text=True, timeout=600)
            tail = (r.stderr or r.stdout).strip().splitlines()[-3:]
            result["tests"] = " ".join(tail)[-300:]
            if r.returncode != 0:
                result["error"] = "тесты новой версии не прошли, ничего не менял"
                return
            result["stage"] = "backup"
            bak = os.path.join(os.path.dirname(APP_DIR), "monitor_bot.bak-update-" + time.strftime("%Y%m%d-%H%M%S"))
            os.makedirs(bak)
            for name in code_items(APP_DIR) + (["VERSION"] if os.path.exists(os.path.join(APP_DIR, "VERSION")) else []):
                s_, d_ = os.path.join(APP_DIR, name), os.path.join(bak, name)
                if os.path.isdir(s_):
                    shutil.copytree(s_, d_, symlinks=True, ignore=shutil.ignore_patterns("__pycache__"))
                else:
                    shutil.copy2(s_, d_)
            result["backup"] = bak
            old_req = os.path.join(APP_DIR, "requirements.txt")
            req_changed = not (os.path.exists(old_req) and filecmp.cmp(old_req, os.path.join(src, "requirements.txt"),
                                                                     shallow=False))
            result["stage"] = "install"
            copy_code(src, APP_DIR, group)
            if req_changed:
                r = pip_install(os.path.join(APP_DIR, "requirements.txt"))
                result["notes"].append("зависимости обновлены" if r.returncode == 0 else
                                       "pip install не удался: " + (r.stderr or r.stdout).strip()[-200:])
            ver = os.path.join(APP_DIR, "VERSION")
            fd = os.open(ver, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump({"sha": sha, "installed": time.time()}, f)
            os.chown(ver, 0, group)
            for rel, installed in NOT_AUTO:
                new = os.path.join(src, rel)
                if os.path.exists(new) and os.path.exists(installed) and not same_config(new, installed):
                    result["notes"].append(f"{installed} изменился в новой версии, его нужно обновить вручную")
            result["stage"] = "restart"
            ok, state = healthy_after_restart()
            if ok:
                result["ok"] = True
                result["stage"] = "done"
                return
            result["error"] = f"новая версия не запустилась ({state}), вернул прежнюю"
            for name in code_items(APP_DIR):  # откат: удалить новое, вернуть старое
                p = os.path.join(APP_DIR, name)
                if not os.path.exists(os.path.join(bak, name)):
                    shutil.rmtree(p) if os.path.isdir(p) else os.remove(p)
            copy_code(bak, APP_DIR, group)
            if os.path.exists(os.path.join(bak, "VERSION")):
                shutil.copy2(os.path.join(bak, "VERSION"), ver)
            if req_changed and os.path.exists(os.path.join(bak, "requirements.txt")):
                r = pip_install(os.path.join(APP_DIR, "requirements.txt"))  # вернуть прежние версии пакетов
                result["notes"].append("зависимости возвращены" if r.returncode == 0 else
                                       "вернуть зависимости не удалось: " + (r.stderr or r.stdout).strip()[-200:])
            ok2, state2 = healthy_after_restart()
            result["stage"] = "rolled_back" if ok2 else "rollback_failed"
            if not ok2:
                result["error"] += f"; после отката бот тоже не запустился ({state2})"
    except Exception as e:  # noqa: BLE001
        result["error"] = f"{result['stage']}: {e}"[:300]
    finally:
        write_result(result)
        os.close(lock)
        os.remove(LOCK_FILE)


def update(sha: str) -> None:
    if not SHA_RE.match(sha):
        die("bad sha")
    if os.path.exists(LOCK_FILE):
        die("update already running", 1)
    unit = "monitor-bot-update-" + sha[:7]
    r = run(["systemd-run", f"--unit={unit}", "--collect", "--quiet", "/usr/bin/python3", "-I",
             os.path.realpath(__file__), "update-run", sha], timeout=30)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "systemd-run failed", 1)
    print(f"started {unit}")


# ---------- Обновления пакетов ----------

def apt_upgradable() -> dict[str, tuple[str, bool]] | None:
    """{пакет: (новая версия, из -security)} по apt list --upgradable. None — apt не ответил."""
    try:
        r = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True, timeout=120,
                           env=APT_ENV, encoding="utf-8", errors="replace")
    except Exception:  # noqa: BLE001
        return None
    if r.returncode != 0:
        return None
    out = {}
    for ln in r.stdout.splitlines():
        m = APT_LINE_RE.match(ln.strip())
        if m and PKG_RE.match(m.group(1)):
            out[m.group(1)] = (m.group(3), "-security" in m.group(2))
    return out


def apt_refresh() -> None:
    if os.path.exists(APT_LOCK):
        die("package upgrade is running", 1)
    r = subprocess.run(["apt-get", "-q", "-o", "DPkg::Lock::Timeout=120", "update"], capture_output=True,
                       text=True, timeout=600, env=APT_ENV)
    if r.returncode != 0:
        die("\n".join((r.stderr or r.stdout).strip().splitlines()[-5:]) or "apt-get update failed", 1)
    pk = apt_upgradable() or {}
    print(f"upgradable {len(pk)}, security {sum(s for __, s in pk.values())}")


def write_apt_result(data: dict) -> None:
    data["finished"] = time.time()
    tmp = APT_RESULT + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, APT_RESULT)


def restarted_services(log: str) -> list[str]:
    """Службы, которые перезапустил needrestart: строки « systemctl restart a.service b.service»."""
    out = []
    for ln in log.splitlines():
        ln = ln.strip()
        if ln.startswith("systemctl restart "):
            out += [u for u in ln.split()[2:] if NAME_RE.match(u) and u not in out]
    return out


def apt_upgrade_run(mode: str) -> None:
    """Выполняется в отдельной службе systemd: перезапуск служб (и самого бота) её не прервёт."""
    if mode not in APT_MODES:
        die("bad mode")
    try:
        lock = os.open(APT_LOCK, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        die("package upgrade is already running", 1)
    result = {"mode": mode, "ok": False, "started": time.time(), "upgraded": [], "left": []}
    try:
        before = apt_upgradable()
        if before is None:
            result["error"] = "apt list failed"
            return
        if mode == "security":
            names = sorted(n for n, (__, sec) in before.items() if sec)
            if not names:
                result["ok"] = True
                return
            cmd = ["apt-get", *APT_OPTS, "install", "--only-upgrade", "--", *names]
        else:
            names = sorted(before)
            if not names:
                result["ok"] = True
                return
            cmd = ["apt-get", *APT_OPTS, "upgrade"]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=3600, env=APT_ENV,
                           encoding="utf-8", errors="replace")
        log = (r.stdout or "") + (r.stderr or "")
        try:
            fd = os.open(APT_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as f:
                f.write(f"\n===== {time.strftime('%Y-%m-%d %H:%M:%S')} {' '.join(cmd[:12])}\n{log}")
        except OSError:
            pass
        after = apt_upgradable() or {}
        result["upgraded"] = [n for n in names if after.get(n, (None,))[0] != before[n][0]]
        result["left"] = [n for n in names if n in after]
        result["restarted"] = restarted_services(log)
        result["log_tail"] = "\n".join(log.strip().splitlines()[-8:])[-1000:]
        if r.returncode != 0:
            result["error"] = f"apt-get exit {r.returncode}"
        else:
            result["ok"] = True
    except Exception as e:  # noqa: BLE001
        result["error"] = str(e)[:300]
    finally:
        result["reboot_required"] = os.path.exists("/var/run/reboot-required")
        try:
            with open("/var/run/reboot-required.pkgs", encoding="utf-8") as f:
                result["reboot_pkgs"] = sorted({ln.strip() for ln in f if ln.strip()})[:20]
        except OSError:
            result["reboot_pkgs"] = []
        write_apt_result(result)
        os.close(lock)
        os.remove(APT_LOCK)


def apt_upgrade(mode: str) -> None:
    if mode not in APT_MODES:
        die("bad mode")
    if os.path.exists(APT_LOCK):
        die("package upgrade is already running", 1)
    unit = APT_UNIT + time.strftime("%Y%m%d-%H%M%S")
    r = run(["systemd-run", f"--unit={unit}", "--collect", "--quiet", "/usr/bin/python3", "-I",
             os.path.realpath(__file__), "apt-upgrade-run", mode], timeout=30)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "systemd-run failed", 1)
    print(f"started {unit}")


def bak_dirs() -> list[tuple[str, float]]:
    parent = os.path.dirname(APP_DIR)
    out = []
    for n in os.listdir(parent):
        p = os.path.join(parent, n)
        if BAK_RE.match(n) and os.path.isdir(p) and not os.path.islink(p):
            out.append((p, os.lstat(p).st_mtime))
    return sorted(out, key=lambda x: x[1], reverse=True)


def bak_list() -> None:
    print(json.dumps([{"path": p, "mtime": m, "size": du_bytes(p)} for p, m in bak_dirs()]))


def prune_bak(keep_s: str) -> None:
    if not keep_s.isdigit() or not 1 <= int(keep_s) <= 20:
        die("bad keep")
    freed, removed = 0, []
    for p, _ in bak_dirs()[int(keep_s):]:
        if os.path.dirname(os.path.realpath(p)) != os.path.dirname(APP_DIR):
            continue
        freed += du_bytes(p)
        shutil.rmtree(p)
        removed.append(os.path.basename(p))
    print(json.dumps({"removed": removed, "freed": freed}))


# ---------- диск и фаервол ----------

def read_io() -> dict[int, tuple[str, int, int]]:
    out = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/io", encoding="utf-8") as f:
                vals = dict(ln.split(": ") for ln in f.read().splitlines() if ": " in ln)
            with open(f"/proc/{d}/comm", encoding="utf-8") as f:
                name = f.read().strip()
            out[int(d)] = (name, int(vals.get("read_bytes", 0)), int(vals.get("write_bytes", 0)))
        except (OSError, ValueError):
            continue
    return out


def io_top() -> None:
    a = read_io()
    time.sleep(2)
    b = read_io()
    rows = []
    for pid, (name, r, w) in b.items():
        if pid in a:
            dr, dw = r - a[pid][1], w - a[pid][2]
            if dr or dw:
                rows.append({"pid": pid, "name": name, "read": dr / 2, "write": dw / 2})
    rows.sort(key=lambda x: x["read"] + x["write"], reverse=True)
    print(json.dumps(rows[:10], ensure_ascii=False))


def parse_ip(s: str):
    """IP или подсеть IPv4 не шире /24 (автобан подсети, из которой подбирают пароль с разных адресов)."""
    if "/" in s:
        try:
            net = ipaddress.ip_network(s, strict=True)
        except ValueError:
            die("bad ip")
        if net.version != 4 or net.prefixlen < 24:
            die("refused: only IPv4 networks /24 or smaller")
        ip = net
    else:
        try:
            ip = ipaddress.ip_address(s)
        except ValueError:
            die("bad ip")
    if ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified or ip.is_reserved:
        die("refused: local or special address")
    return ip


def covers_peer(target, peers: set[str]) -> bool:
    """Правило задело бы открытую SSH-сессию."""
    if isinstance(target, ipaddress.IPv4Network):
        for p in peers:
            try:
                if ipaddress.ip_address(p) in target:
                    return True
            except ValueError:
                continue
        return False
    return str(target) in peers


def sshd_ports() -> set[str]:
    """Порты, которые слушает sshd (или systemd для ssh.socket). Если узнать не удалось — 22."""
    r = run(["ss", "-H", "-tlnp"])
    ports = set()
    for ln in r.stdout.splitlines():
        if '"sshd"' in ln:
            parts = ln.split()
            if len(parts) >= 4:
                port = parts[3].rpartition(":")[2]
                if port.isdigit():
                    ports.add(port)
    # Ubuntu по умолчанию запускает SSH через ssh.socket: тогда порт слушает systemd
    r = run(["systemctl", "show", "ssh.socket", "-p", "Listen", "--value"])
    for m in re.finditer(r":(\d+) \(Stream\)", r.stdout):
        ports.add(m.group(1))
    return ports or {"22"}


def logged_in_hosts() -> set[str] | None:
    """IP, с которых сейчас есть вошедшие (прошедшие проверку ключа) SSH-сессии, по данным systemd-logind.
    None — если logind недоступен: тогда считаем сессией любое соединение, как раньше."""
    r = run(["loginctl", "list-sessions", "--no-legend"])
    if r.returncode != 0:
        return None
    hosts = set()
    for ln in r.stdout.splitlines():
        sid = ln.split()[0] if ln.split() else ""
        if not sid:
            continue
        s = run(["loginctl", "show-session", sid, "-p", "Remote", "-p", "RemoteHost", "-p", "Service"])
        props = dict(x.split("=", 1) for x in s.stdout.splitlines() if "=" in x)
        if props.get("Remote") == "yes" and props.get("Service", "").startswith("sshd") and props.get("RemoteHost"):
            hosts.add(props["RemoteHost"].removeprefix("::ffff:"))
    return hosts


def ssh_peers() -> set[str]:
    """IP, с которых сейчас открыты SSH-сессии: их не блокируем, чтобы не отрезать себя.
    Соединение, которое ещё не вошло (перебор ключей, [preauth]), сессией не считается — иначе
    атакующий уходит от бана именно тогда, когда активен."""
    peers = tcp_ssh_peers()
    hosts = logged_in_hosts()
    return peers if hosts is None else peers & hosts


def tcp_ssh_peers() -> set[str]:
    """IP всех установленных TCP-соединений с портом sshd."""
    ports = sshd_ports()
    r = run(["ss", "-H", "-tn", "state", "established"])
    peers = set()
    for ln in r.stdout.splitlines():
        parts = ln.split()
        if len(parts) >= 4:
            local_port = parts[-2].rpartition(":")[2]
            if local_port not in ports:
                continue
            addr = parts[-1].rpartition(":")[0].strip("[]")
            peers.add(addr.removeprefix("::ffff:"))
    return peers


def ufw_active() -> bool:
    r = run(["ufw", "status"])
    return r.returncode == 0 and "Status: active" in r.stdout


def banned() -> list[str]:
    r = run(["ufw", "status"])
    ips = []
    for ln in r.stdout.splitlines():
        if "DENY" in ln and f"# {BAN_COMMENT}" in ln:
            tokens = ln.split("DENY", 1)[1].split()  # «Anywhere  DENY  203.0.113.5  # monitor-bot»
            if tokens and tokens[0] == "IN":
                tokens = tokens[1:]
            src = tokens[0] if tokens and tokens[0] != "#" else ""
            if src and src not in ips:
                ips.append(src)
    return ips


def ban_ip(s: str) -> None:
    ip = parse_ip(s)
    if covers_peer(ip, ssh_peers()):
        die("refused: this IP has an open SSH session")
    if not ufw_active():
        die("ufw is not active", 1)
    if str(ip) in banned():
        print(f"already banned {ip}")
        return
    # prepend ставит правило первым в своём списке (IPv4 или IPv6); «insert 1» для IPv6 ufw отклоняет,
    # если первое правило — IPv4
    r = run(["ufw", "prepend", "deny", "from", str(ip), "to", "any", "comment", BAN_COMMENT])
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "ufw failed", 1)
    print(f"banned {ip}")


def unban_ip(s: str) -> None:
    ip = parse_ip(s)
    if str(ip) not in banned():
        die("not banned by monitor-bot", 1)
    r = run(["ufw", "delete", "deny", "from", str(ip), "to", "any", "comment", BAN_COMMENT])
    if r.returncode != 0:
        r = run(["ufw", "delete", "deny", "from", str(ip), "to", "any"])
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "ufw failed", 1)
    print(f"unbanned {ip}")


def docker_poll() -> None:
    """docker ps и docker inspect всех контейнеров одним вызовом (JSON {"ps": ..., "inspect": ...}):
    бот проверяет Docker каждую минуту, и каждый вызов через sudo оставляет строки в системном журнале."""
    def dk(args: list[str]) -> subprocess.CompletedProcess:
        try:
            return subprocess.run(["docker", *args], capture_output=True, text=True, timeout=30)
        except subprocess.TimeoutExpired:
            die("docker timeout", 1)
        except OSError as e:
            die(f"docker: {e}", 1)
    ps = dk(["ps", "-a", "--format", PS_FMT])
    if ps.returncode != 0:
        sys.stderr.write(ps.stderr)
        sys.exit(ps.returncode or 1)
    names = [ln.split("\t", 1)[0] for ln in ps.stdout.splitlines() if "\t" in ln]
    names = [n for n in names if CONTAINER_RE.match(n)][:200]
    inspect = dk(["inspect", "--format", INSPECT_FMT, *names]).stdout if names else ""
    pr = dk(["ps", "--format", PORTS_FMT])
    print(json.dumps({"ps": ps.stdout, "inspect": inspect, "ports": pr.stdout if pr.returncode == 0 else None}))


def docker_names(names: list[str]) -> list[str]:
    if not names or len(names) > 50 or not all(CONTAINER_RE.match(n) for n in names):
        die("bad container name")
    return names


def docker_cmd(args: list[str]) -> None:
    """Разрешённые вызовы docker (см. описание вверху). Вывод и код возврата docker передаются как есть."""
    timeout = 30
    if args == ["ps", "-a", "--format", PS_FMT] or args == ["stats", "--no-stream", "--format", STATS_FMT]:
        cmd = args
    elif len(args) >= 4 and args[:3] == ["inspect", "--format", INSPECT_FMT]:
        cmd = args[:3] + docker_names(args[3:])
    elif len(args) == 4 and args[0] == "logs" and args[1] in ("--tail", "--since") and args[2].isdigit():
        if args[1] == "--tail" and not 1 <= int(args[2]) <= 1000:
            die("bad tail")
        cmd = args[:3] + docker_names(args[3:])
    elif len(args) == 2 and args[0] == "restart":
        cmd = ["restart"] + docker_names(args[1:])
        timeout = 120
    else:
        die("refused: docker command is not allowed")
    try:
        r = subprocess.run(["docker", *cmd], capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        die("docker timeout", 1)
    except OSError as e:
        die(f"docker: {e}", 1)
    sys.stdout.buffer.write(r.stdout)
    sys.stderr.buffer.write(r.stderr)
    sys.exit(r.returncode)


# ---------- Кто имеет доступ (access-audit) ----------
# Только отпечатки ключей, имена и хеши файлов: сами ключи и содержимое sudoers не выдаются.

KEY_TYPES = ("ssh-ed25519", "ssh-rsa", "ssh-dss", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384",
             "ecdsa-sha2-nistp521", "sk-ssh-ed25519@openssh.com", "sk-ecdsa-sha2-nistp256@openssh.com")
PRIV_GROUPS = ("sudo", "admin", "wheel", "docker")   # группа docker даёт root
NOLOGIN = ("nologin", "false", "sync", "shutdown", "halt")
AUDIT_MAX = 1 << 20


def _read_nofollow(path: str) -> str | None:
    """Прочитать обычный файл, не переходя по символической ссылке (её мог подложить пользователь)."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0))
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        with os.fdopen(fd, "rb") as fh:
            fd = -1
            return fh.read(AUDIT_MAX).decode("utf-8", "replace")
    finally:
        if fd >= 0:
            os.close(fd)


def _fp(blob_b64: str) -> str | None:
    try:
        raw = base64.b64decode(blob_b64, validate=True)
    except ValueError:
        return None
    return "SHA256:" + base64.b64encode(hashlib.sha256(raw).digest()).decode().rstrip("=")


def parse_authorized_keys(text: str) -> list[dict]:
    """[{type, fp, comment, opts}] — opts: параметры перед ключом (command=…, restrict), обрезанные."""
    out = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        for i, w in enumerate(parts[:-1]):
            if w in KEY_TYPES:
                fp = _fp(parts[i + 1])
                if fp:
                    opts = line.split(w, 1)[0].strip() if i else ""
                    comment = " ".join(parts[i + 2:])
                    out.append({"type": w, "fp": fp, "comment": comment[:80], "opts": opts[:200]})
                break
    return out


def parse_passwd(text: str) -> list[tuple[str, int, int, str, str]]:
    rows = []
    for line in text.splitlines():
        f = line.split(":")
        if len(f) >= 7 and f[2].isdigit() and f[3].isdigit():
            rows.append((f[0], int(f[2]), int(f[3]), f[5], f[6]))
    return rows


def parse_groups(text: str) -> dict[str, tuple[int, list[str]]]:
    out = {}
    for line in text.splitlines():
        f = line.split(":")
        if len(f) >= 4 and f[2].isdigit():
            out[f[0]] = (int(f[2]), [m for m in f[3].split(",") if m])
    return out


def access_audit(root: str = "/") -> dict:
    """Ключи SSH, пользователи с оболочкой, uid 0, члены sudo/admin/wheel/docker и хеши файлов sudoers."""
    j = lambda *p: os.path.join(root, *p)  # noqa: E731 — root подменяют тесты
    users = parse_passwd(_read_nofollow(j("etc/passwd")) or "")
    groups = parse_groups(_read_nofollow(j("etc/group")) or "")
    login = sorted(u for u, uid, _g, _h, sh in users if not sh.rstrip("/").endswith(NOLOGIN) and sh)
    keys: dict[str, list] = {}
    for u, uid, _g, home, sh in users:
        if uid != 0 and u not in login:
            continue
        if not home.startswith("/") or ".." in home.split("/"):
            continue
        found = []
        for name in ("authorized_keys", "authorized_keys2"):
            text = _read_nofollow(j(home.lstrip("/"), ".ssh", name))
            if text:
                found += parse_authorized_keys(text)
        if found:
            keys[u] = found[:100]
    priv: dict[str, list] = {}
    for g in PRIV_GROUPS:
        if g in groups:
            gid, members = groups[g]
            m = set(members) | {u for u, _uid, ugid, _h, _s in users if ugid == gid}
            if m:
                priv[g] = sorted(m)
    sudoers = {}
    paths = [j("etc/sudoers")]
    try:
        paths += sorted(j("etc/sudoers.d", n) for n in os.listdir(j("etc/sudoers.d")))
    except OSError:
        pass
    for p in paths[:100]:
        text = _read_nofollow(p)
        if text is not None:
            sudoers["/" + os.path.relpath(p, root)] = hashlib.sha256(text.encode()).hexdigest()[:16]
    return {"keys": keys, "login_users": login[:200], "uid0": sorted(u for u, uid, *_r in users if uid == 0),
            "groups": priv, "sudoers": sudoers}


