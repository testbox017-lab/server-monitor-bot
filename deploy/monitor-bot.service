# Автозапуск на Linux через systemd.
# Поменяйте пути и пользователя, затем:
#   sudo cp monitor-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now monitor-bot
[Unit]
Description=Telegram server monitoring bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitor
WorkingDirectory=/opt/monitor_bot
ExecStart=/opt/monitor_bot/venv/bin/python /opt/monitor_bot/bot.py /opt/monitor_bot/config.yaml
Restart=always
RestartSec=10
# /var/lib/monitor_bot для settings.json и state.json, доступна на запись пользователю службы
StateDirectory=monitor_bot

[Install]
WantedBy=multi-user.target
