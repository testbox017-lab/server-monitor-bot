# Автобан SSH на другом сервере (remote_servers): /etc/fail2ban/jail.d/monitor-bot.local
# Работает на самом сервере, поэтому блокирует и тогда, когда главный бот недоступен.
# Те же правила, что у автобана главного сервера: 10 попыток за 10 минут или 20 за час,
# бан на сутки, повторный бан всё дольше (до 30 дней). Блокирует через ufw.
# В ignoreip впишите адрес главного сервера (он заходит сюда ключом агента каждую минуту).

[DEFAULT]
banaction = ufw
ignoreip = 127.0.0.1/8 ::1 MAIN_SERVER_IP
bantime = 24h
bantime.increment = true
bantime.maxtime = 30d

[sshd]
enabled = true
backend = systemd
mode = aggressive
# В Ubuntu 26.04 строки о входах пишет sshd-session, а не sshd: фильтр по умолчанию их не видит
journalmatch = _SYSTEMD_UNIT=ssh.service
findtime = 10m
maxretry = 10

# Медленный подбор «под порогом»: тот же фильтр, окно час
[sshd-slow]
enabled = true
filter = sshd[mode=aggressive]
backend = systemd
journalmatch = _SYSTEMD_UNIT=ssh.service
port = ssh
findtime = 1h
maxretry = 20
