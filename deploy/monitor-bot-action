def die(msg: str, code: int = 2) -> None:
    print(msg)
    sys.exit(code)


def run(cmd: list[str], timeout: int = 300) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def allowed_services() -> set[str]:
    try:
        with open(ALLOWED_FILE, encoding="utf-8") as f:
            return {ln.strip() for ln in f if ln.strip() and not ln.startswith("#")}
    except OSError:
        return set()


def restart_service(name: str) -> None:
    if not NAME_RE.match(name):
        die("bad service name")
    if name not in allowed_services():
        die(f"service {name} is not in {ALLOWED_FILE}")
    r = run(["systemctl", "restart", name], timeout=120)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "systemctl failed", 1)
    print(run(["systemctl", "is-active", name]).stdout.strip())


def proc_name(pid: int) -> str:
    try:
        with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        die("no such process")


def kill(pid_s: str) -> None:
    if not pid_s.isdigit():
        die("bad pid")
    pid = int(pid_s)
    if pid <= 2 or pid == os.getpid() or pid == os.getppid():
        die("refused: protected pid")
    name = proc_name(pid)
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if not f.read():
                die("refused: kernel thread")
    except OSError:
        die("no such process")
    if name in PROTECTED or name.startswith(PROTECTED_PREFIXES):
        die(f"refused: {name} is protected")
    try:
        with open(f"/proc/{pid}/cgroup", encoding="utf-8") as f:
            cgroup = f.read()
    except OSError:
        cgroup = ""
    if any(u in cgroup for u in PROTECTED_UNITS):
        die("refused: bot update is running")
    if APT_UNIT in cgroup:
        die("refused: package upgrade is running")
    os.kill(pid, signal.SIGTERM)
    print(f"SIGTERM sent to {pid} ({name})")


def du_bytes(path: str) -> int:
    r = run(["du", "-sb", path])
    try:
        return int(r.stdout.split()[0])
    except (IndexError, ValueError):
        return 0


def cleanup_estimate() -> None:
    lines = []
    r = run(["docker", "system", "df", "--format", "{{.Type}}\t{{.Reclaimable}}"])
    if r.returncode == 0:
        for ln in r.stdout.splitlines():
            t, _, rec = ln.partition("\t")
            if t in ("Images", "Build Cache"):
                lines.append(f"docker {t}: {rec}")
    r = run(["journalctl", "--disk-usage"])
    if r.returncode == 0:
        lines.append(f"journal: {r.stdout.strip()} (limit {JOURNAL_LIMIT})")
    apt = du_bytes("/var/cache/apt/archives")
    lines.append(f"apt cache: {apt / 1e6:.0f} MB")
    print("\n".join(lines))


def cleanup() -> None:
    out = []
    for cmd in (["docker", "image", "prune", "-f"], ["docker", "builder", "prune", "-f"],
                ["journalctl", f"--vacuum-size={JOURNAL_LIMIT}"], ["apt-get", "clean"]):
        r = run(cmd)
        tail = (r.stdout.strip().splitlines() or [""])[-1] or (r.stderr.strip().splitlines() or [""])[-1]
        out.append(f"{' '.join(cmd[:3])}: {'ok' if r.returncode == 0 else 'error'} {tail}".strip())
    print("\n".join(out))


# ---------- бэкапы ----------

def watch_dirs() -> list[tuple[str, float]]:
    """[(папка, максимальный возраст в часах)] из WATCH_FILE: «/var/backups/x 26»."""
    out = []
    try:
        with open(WATCH_FILE, encoding="utf-8") as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#"):
                    continue
                parts = ln.split()
                path = parts[0]
                hours = float(parts[1]) if len(parts) > 1 else 26.0
                if os.path.isabs(path):
                    out.append((os.path.normpath(path), hours))
    except (OSError, ValueError):
        pass
    return out


def backup_files(path: str) -> list[tuple[str, int, float]]:
    """[(имя, размер, mtime)] обычных файлов папки, новые первыми."""
    files = []
    try:
        with os.scandir(path) as it:
            for e in it:
                if e.is_file(follow_symlinks=False):
                    st = e.stat(follow_symlinks=False)
                    files.append((e.name, st.st_size, st.st_mtime))
    except OSError:
        return []
    files.sort(key=lambda x: x[2], reverse=True)
    return files


def backup_status() -> None:
    res = []
    for path, hours in watch_dirs():
        files = backup_files(path)
        dated = [f for f in files if not f[0].startswith("latest")]  # latest.* — копия последнего
        res.append({"path": path, "max_age_h": hours, "exists": os.path.isdir(path),
                    "count": len(dated), "total": sum(f[1] for f in files),
                    "newest": list(dated[0]) if dated else (list(files[0]) if files else None),
                    "previous": list(dated[1]) if len(dated) > 1 else None})
    print(json.dumps(res, ensure_ascii=False))


def gid() -> int:
    try:
        return grp.getgrnam(BOT_GROUP).gr_gid
    except KeyError:
        return 0


def backup_fetch(n_s: str) -> None:
    """Копия последнего бэкапа в OUTBOX (root:monitor), чтобы бот мог отправить её в Telegram."""
    dirs = watch_dirs()
    if not n_s.isdigit() or int(n_s) >= len(dirs):
        die("bad index")
    path = dirs[int(n_s)][0]
    files = [f for f in backup_files(path) if not f[0].startswith("latest")] or backup_files(path)
    if not files:
        die("no backups", 1)
    name, size, _ = files[0]
    if size > MAX_SEND:
        die(f"too big: {size}", 1)
    # OUTBOX в /run принадлежит root: пользователь бота не может подложить туда ссылку
    if os.path.lexists(OUTBOX) and (os.path.islink(OUTBOX) or not os.path.isdir(OUTBOX)):
        die("bad outbox", 1)
    os.makedirs(OUTBOX, exist_ok=True)
    os.chown(OUTBOX, 0, gid())
    os.chmod(OUTBOX, 0o750)
    for old in os.listdir(OUTBOX):  # держим только один файл
        os.remove(os.path.join(OUTBOX, old))
    dest = os.path.join(OUTBOX, name)
    try:
        src = open_regular(os.path.join(path, name))
    except OSError as e:
        die(f"refused: {e}", 1)
    dst_fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640)
    with src as a, os.fdopen(dst_fd, "wb") as b:
        shutil.copyfileobj(a, b)
    os.chown(dest, 0, gid())
    print(json.dumps({"file": dest, "size": size}))


# ---------- копии на ПК и проверка копий ----------

def newest_copies() -> list[tuple[str, str, str, int]]:
    """[(метка, папка, имя, размер)]: последняя копия бота и по одной из каждой папки backup-watch."""
    out = []
    own = [f for f in backup_files(OWN_BACKUPS) if OWN_RE.match(f[0])]
    if own:
        out.append(("monitor-bot", OWN_BACKUPS, own[0][0], own[0][1]))
    used = {"monitor-bot"}
    for path, _ in watch_dirs():
        files = [f for f in backup_files(path) if not f[0].startswith("latest")] or backup_files(path)
        if not files:
            continue
        label = LABEL_RE.sub("_", os.path.basename(path) or "root")[:40] or "dir"
        while label in used:
            label += "_"
        used.add(label)
        out.append((label, path, files[0][0], files[0][1]))
    return out


def hardlinks_protected() -> bool:
    try:
        with open("/proc/sys/fs/protected_hardlinks", encoding="utf-8") as f:
            return f.read().strip() == "1"
    except OSError:
        return False


def open_regular(path: str):
    """Открыть обычный файл без перехода по ссылкам. Жёсткая ссылка допустима, только если ядро не даёт
    обычным пользователям ссылаться на чужие файлы (fs.protected_hardlinks=1): иначе через неё можно
    подсунуть, например, /etc/shadow."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    f = os.fdopen(fd, "rb")
    st = os.fstat(f.fileno())
    if not stat.S_ISREG(st.st_mode):
        f.close()
        raise OSError("not a regular file")
    if st.st_nlink > 1 and not hardlinks_protected():
        f.close()
        raise OSError("hard link refused (fs.protected_hardlinks is off)")
    return f


class HashReader:
    def __init__(self, f):
        self.f, self.h = f, hashlib.sha256()

    def read(self, n: int = -1) -> bytes:
        b = self.f.read(n)
        self.h.update(b)
        return b


def write_status(data: dict) -> None:
    if os.path.islink(OFFSITE_DIR):
        die("bad offsite dir", 1)
    os.makedirs(OFFSITE_DIR, mode=0o755, exist_ok=True)
    tmp = OFFSITE_STATUS + ".tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, OFFSITE_STATUS)


def pull_stream() -> None:
    """tar в stdout: <метка>/<файл> для каждой последней копии и SHA256SUMS в конце."""
    items = newest_copies()
    if not items:  # stdout — это поток для ПК, поэтому ошибку пишем в stderr
        sys.stderr.write("no backups\n")
        sys.exit(1)
    sums, sent = [], []
    out = sys.stdout.buffer
    with tarfile.open(fileobj=out, mode="w|", format=tarfile.PAX_FORMAT) as tar:
        for label, path, name, _ in items:
            try:
                f = open_regular(os.path.join(path, name))
            except OSError:
                continue
            with f:
                st = os.fstat(f.fileno())
                info = tarfile.TarInfo(f"{label}/{name}")
                info.size, info.mtime, info.mode = st.st_size, int(st.st_mtime), 0o600
                r = HashReader(f)
                tar.addfile(info, r)
            sums.append(f"{r.h.hexdigest()}  {label}/{name}")
            sent.append({"path": path, "name": name, "size": st.st_size, "mtime": st.st_mtime})
        data = ("\n".join(sums) + "\n").encode()
        info = tarfile.TarInfo("SHA256SUMS")
        info.size, info.mtime, info.mode = len(data), int(time.time()), 0o644
        tar.addfile(info, io.BytesIO(data))
    out.flush()
    client = (os.environ.get("SSH_CONNECTION") or "").split(" ")[0]
    write_status({"ts": time.time(), "files": sent, "bytes": sum(x["size"] for x in sent), "client": client})


def verify_file(path: str, name: str) -> dict:
    """Прочитать копию целиком: у tar — каждый файл внутри, у gzip — контрольную сумму."""
    full = os.path.join(path, name)
    try:
        with open_regular(full) as f:
            low = name.lower()
            if ".tar" in low or low.endswith(".tgz"):
                n = 0
                with tarfile.open(fileobj=f, mode="r:*") as t:
                    for m in t:
                        if m.isfile():
                            ex = t.extractfile(m)
                            while ex.read(1 << 20):
                                pass
                        n += 1
                return {"ok": n > 0, "members": n, "error": None if n else "архив пустой"}
            if low.endswith(".gz"):
                with gzip.GzipFile(fileobj=f) as g:
                    while g.read(1 << 20):
                        pass
                return {"ok": True, "members": 1, "error": None}
            while f.read(1 << 20):
                pass
            return {"ok": True, "members": 1, "error": None, "note": "не архив, проверено только чтение"}
    except (OSError, EOFError, tarfile.TarError, zlib.error, gzip.BadGzipFile) as e:
        return {"ok": False, "members": 0, "error": f"{type(e).__name__}: {e}"[:200]}


def backup_verify() -> None:
    res = []
    for label, path, name, size in newest_copies():
        r = {"label": label, "path": path, "name": name, "size": size}
        r.update(verify_file(path, name))
        res.append(r)
    print(json.dumps(res, ensure_ascii=False))


